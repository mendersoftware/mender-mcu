menu "Mender client"

    menu "Storage options"

         config MENDER_STORAGE_PARTITION_LABEL
             string "Label of partition to store persistent Mender data"
             default "mender"
             help
                 Use "nvs" to use the ESP-IDF's default non-volatile storage partition (not recommended), or see
                 https://docs.espressif.com/projects/esp-idf/en/stable/esp32/api-guides/partition-tables.html#creating-custom-tables
                 for partition table definition docs and how to define a partition with label "mender".

    endmenu

    menu "Scheduler options (ADVANCED)"

        config MENDER_SCHEDULER_WORK_QUEUE_STACK_SIZE
            int "Mender Scheduler Work Queue Stack Size (kB)"
            range 1 64
            default 12
            help
                Mender scheduler work queue stack size, customize only if you have a deep understanding of the impacts! Default value is suitable for most applications.

        config MENDER_SCHEDULER_WORK_QUEUE_PRIORITY
            int "Mender Scheduler Work Queue Priority"
            range 1 24
            default 1
            help
                Mender scheduler work queue priority (higher number = higher priority), customize only if you have a deep understanding of the impacts! Default value is suitable for most applications.

        config MENDER_SCHEDULER_WORK_QUEUE_LENGTH
            int "Mender Scheduler Work Queue Length"
            range 1 64
            default 10
            help
                Mender scheduler work queue capacity (pending work items), customize only if you have a deep understanding of the impacts! Default value is suitable for most applications.

    endmenu

    # Hidden symbol (no prompt) that is always enabled (default y), allowing us to unconditionally select dependencies
    config MENDER_FORCED_DEPS
        bool
        default y
        # Enables use of MbedTLS's internal CA bundle for verification
        select MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY

endmenu
